digraph G {
splines = line
	graph [bgcolor = "#5B8298"]
	node [shape = record, fontname = "Consolas", style = "rounded, filled", height = 0.5, width = 1, color = "#86BBD8", fontcolor = "#E8F1F5", penwidth = 3]
	edge [color = "#2F4858", fontcolor = "#2F4858", penwidth = 2, arrowsize = 0.6];


	node [fillcolor = "#78a5728b"]

}
